// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/rocker-org/devcontainer-templates/tree/main/src/r-ver
{
  "containerEnv": {
    "DEBUGME": "R_GlobalEnv",
    "TZ": "Europe/Lisbon",
    "GIT_AUTHOR_NAME": "Francisco Bischoff",
    "GIT_AUTHOR_EMAIL": "franzbischoff@gmail.com",
    "GIT_COMMITTER_NAME": "Francisco Bischoff",
    "GIT_COMMITTER_EMAIL": "franzbischoff@gmail.com"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "affenwiesel.matlab-formatter",
        "alefragnani.project-manager",
        "christian-kohler.path-intellisense",
        "eamodio.gitlens",
        "EditorConfig.EditorConfig",
        "gerane.Theme-Twilight",
        "github.vscode-github-actions",
        "hediet.vscode-drawio",
        "james-yu.latex-workshop",
        "marvhen.reflow-markdown",
        "mechatroner.rainbow-csv",
        "mitchdenny.ecdc",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-wsl",
        "mutantdino.resourcemonitor",
        "natqe.reload",
        "PKief.material-icon-theme",
        "quarto.quarto",
        "RDebugger.r-debugger",
        "REditorSupport.r",
        "reditorsupport.r",
        "richie5um2.vscode-sort-json",
        "spmeesseman.vscode-taskexplorer",
        "usernamehw.errorlens"
      ]
    }
  },
  "features": {
    "ghcr.io/dhoeric/features/hadolint:1": {
      "version": "latest"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": [
        "curl",
        "gnupg",
        "less",
        "locales",
        "procps",
        "tzdata",
        "librsvg2-bin",
        "libzmq3-dev",
        "libudunits2-dev",
        "libgdal-dev",
        "libmagick++-dev",
        "libnode-dev", // needed for jsonld
        "build-essential",
        "clang-format-14",
        "qpdf", // to check PDFs generated by compilation of the package
        "texlive-latex-base", // pdflatex
        "fonts-inconsolata" // for inconsolata font in pdfs
      ]
    },
    "ghcr.io/rocker-org/devcontainer-features/pandoc:1": {
      "version": "latest"
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "installChromium": true,
      "installTinyTex": true,
      "version": "latest"
    },
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "jsonlite,languageserver,conflicted,prompt,here,readr,covr,miniCRAN,httpgd"
    },
    "ghcr.io/rocker-org/devcontainer-features/renv-cache:0": {}
  },
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "ghcr.io/rocker-org/devcontainer/r-ver:4.4",
  "name": "false.alarm devcontainer",
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh"
  // "updateContentCommand": "Rscript -e 'renv::restore()'"
  // cd ${workspaceFolder} && Rscript -e \\'renv::restore()\\''"
  // Configure tool-specific properties.
  // "customizations": {},
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
